var 1..4: x1;
var 1..4: x2;
var 1..4: x3;
var 1..4: x4;
var 0..1: e1;
var 0..1: e2;
var 0..1: e3;
constraint int_eq_reif(x1, x2, e1);
constraint int_eq_reif(x2, x3, e2);
constraint int_eq_reif(x3, x4, e3);
constraint int_ne(x1, x4);
constraint int_lin_le([-1, -1, -1], [e1, e2, e3], -2);
solve satisfy;